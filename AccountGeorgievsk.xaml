<Window x:Class="TransportDepartment.AccountGeorgievsk"
        x:Name="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransportDepartment"
        mc:Ignorable="d"
        Title="AccountGeorgievsk"
        Height="450"
        Loaded="AccountGeorgievsk_Loaded"
        Width="599"
        Background="#F5F7FA"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Палитра цветов -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#2C3E50"/>

        <!-- Цвета, точно соответствующие визуалу вашей кнопки -->
        <SolidColorBrush x:Key="ButtonBaseColor" Color="#3B8ED0"/>
        <SolidColorBrush x:Key="ButtonHoverColor" Color="#2E7ACF"/>
        <SolidColorBrush x:Key="ButtonPressedColor" Color="#256BB8"/>

        <!-- Стиль ModernButtonStyle, полностью инкапсулирующий логику кнопки -->
            <!-- Цвета: спокойные, не кричащие, но заметные -->
            <!-- Почти белый, но не стерильный -->
            <!-- Мягкий серый для рамки -->
            <!-- Деловой синий (не кислотный) -->
  
            <!-- Тёмно-графитовый, а не чёрный -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBaseColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Border содержит скругление и тень -->
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Состояние: Наведение мыши -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHoverColor}"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" 
                                                          Opacity="0.4" 
                                                          BlurRadius="15" 
                                                          ShadowDepth="4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Состояние: Нажатие -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonPressedColor}"/>
                            </Trigger>

                            <!-- Состояние: По умолчанию (без наведения) -->
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" 
                                                          Opacity="0.2" 
                                                          BlurRadius="10" 
                                                          ShadowDepth="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FriendlyStrictButton" TargetType="Button">
                <Setter Property="Background" Value="#F5F6F7"/>
                <Setter Property="Foreground" Value="#1E293B"/>
                <Setter Property="BorderBrush" Value="#D1D5DB"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="14,8"/>
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" 
                            SnapsToDevicePixels="True">
                              
                            <TextBlock x:Name="textBlock"
                               TextWrapping="Wrap"
                               TextAlignment="{TemplateBinding HorizontalContentAlignment}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               Foreground="{TemplateBinding Foreground}"
                               Padding="{TemplateBinding Padding}"
                               Text="{TemplateBinding Content}"/>
                        </Border>

                            <ControlTemplate.Triggers>
                                <!-- Наведение: кнопка становится активной, но не «кричащей» -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="border" Property="TextElement.Foreground" Value="#2563EB"/>
                                </Trigger>

                                <!-- Нажатие: чёткое ощущение нажатия без «взрыва» цвета -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#DBEAFF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#1E40AF"/>
                                </Trigger>

                                <!-- Фокус с клавиатуры: видно, что кнопка выбрана -->
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                </Trigger>

                                <!-- Отключённое состояние: спокойно, без агрессии -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter TargetName="border" Property="TextElement.Foreground" Value="#94A3B8"/>
                                    <Setter Property="Cursor" Value="No"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Георгиевское отделение ГУП СК «КРАЙТЕПЛОЭНЕРГО»"
                   FontSize="20"
                   FontWeight="Bold"
                   Foreground="{StaticResource PrimaryColor}"
                   TextAlignment="Center"
                   Margin="0,10,0,0"/>

        <WrapPanel x:Name="TransportButtonsPanel" Grid.Row="1" Margin="20"/>


        <!-- Кнопка теперь максимально чистая: только имя, контент и ссылка на стиль -->
        <Button x:Name="onMainWindow" 
                Grid.Row="2"
                Content="ВЕРНУТЬСЯ НА ГЛАВНЫЙ ЭКРАН"
                Style="{StaticResource ModernButtonStyle}"
                HorizontalAlignment="Left" 
                VerticalAlignment="Bottom" 
                Margin="10" Click="onMainWindow_Click" />
    </Grid>
</Window>
