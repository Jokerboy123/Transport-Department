<Window x:Class="TransportDepartment.AccountingCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransportDepartment"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Background="#F3F5F7">

    <Window.Resources>
        <SolidColorBrush x:Key="ButtonBaseColor" Color="#3B8ED0"/>
        <SolidColorBrush x:Key="ButtonHoverColor" Color="#2E7ACF"/>
        <SolidColorBrush x:Key="ButtonPressedColor" Color="#256BB8"/>
        <SolidColorBrush x:Key="PrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="AccentColor" Color="#3498DB"/>
        <SolidColorBrush x:Key="HoverColor" Color="#2980B9"/>
        <SolidColorBrush x:Key="BorderColor" Color="#DDE1E6"/>
        <SolidColorBrush x:Key="HeaderBgColor" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="InfoTextColor" Color="#6C757D"/>
        <SolidColorBrush x:Key="CellTextColor" Color="#37474F"/>
        <SolidColorBrush x:Key="SubHeaderColor" Color="#78868F"/>

        <DropShadowEffect x:Key="CardShadow"
                          Color="#000000"
                          Opacity="0.06"
                          BlurRadius="20"
                          ShadowDepth="2"
                          Direction="270"/>

        <Style x:Key="PageHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
            <Setter Property="TextAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>

        <Style x:Key="InfoLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{StaticResource InfoTextColor}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="InfoValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
        </Style>

        <Style x:Key="DataGridHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{StaticResource SubHeaderColor}"/>
            <Setter Property="Padding" Value="8,10"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="SeparatorVisibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBaseColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHoverColor}"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000"
                                                          Opacity="0.4"
                                                          BlurRadius="15"
                                                          ShadowDepth="4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonPressedColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000"
                                                          Opacity="0.2"
                                                          BlurRadius="10"
                                                          ShadowDepth="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GroupSubHeaderStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{StaticResource SubHeaderColor}"/>
            <Setter Property="Padding" Value="4,6"/>
        </Style>

        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource CellTextColor}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- === ШАПКА === -->
        <Border Grid.Row="0" Background="White" CornerRadius="16" Padding="30" Margin="0,0,0,28"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="806*"/>
                            <ColumnDefinition Width="187*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Карточка учёта эксплуатации автомобиля" Style="{StaticResource PageHeaderStyle}" Margin="0,0,0,24"/>
                        <Button Content="Печать" Style="{StaticResource ModernButtonStyle}" Margin="1612,0,0,0" Grid.ColumnSpan="2" Click="Button_Click"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="Гос. номер:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Text="{Binding CurrentTransport.StateNumber, FallbackValue='—'}" Style="{StaticResource InfoValueStyle}" FontSize="18"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="Марка:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Text="{Binding CurrentTransport.TransportBrand, FallbackValue='—'}" Style="{StaticResource InfoValueStyle}" FontSize="18"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Период:" Style="{StaticResource InfoLabelStyle}"/>
                            <TextBlock Style="{StaticResource InfoValueStyle}" FontSize="18">
                                <Run Text="{Binding SelectedMonth, Source={x:Static local:Parameters.Instance}, FallbackValue='—'}"/>
                                <Run Text=" "/>
                                <Run Text="{Binding SelectedYear, Source={x:Static local:Parameters.Instance}, FallbackValue='—'}"/>
                                <Run Text=" года"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- === ТАБЛИЦА === -->
        <Border Grid.Row="1" Background="White" CornerRadius="16" Margin="0,0,0,28"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Строка "Остаток на начало" -->
                <Border Grid.Row="0" Background="#F8FAFF" BorderBrush="#E3F2FD" BorderThickness="0,0,0,1"
                        Padding="24,14" CornerRadius="16,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Остаток на начало месяца:"
                                   FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource PrimaryColor}"
                                   Margin="0,0,20,0"/>
                        <TextBlock Grid.Column="1" FontSize="14" Foreground="#6C757D" TextAlignment="Left">
        <Run Text="Спидометр: " />
        <Run Text="{Binding AccountingCardProperties.RemaindMonthKilometrageValue, FallbackValue='—'}" />
        <Run Text=" км | СУГ: " />
        <Run Text="{Binding AccountingCardProperties.RemaindMonthGasValue, FallbackValue='—'}" />
        <Run Text=" л | Бензин: " />
        <Run Text="{Binding AccountingCardProperties.RemaindMonthPetrolValue, FallbackValue='—'}" />
        <Run Text=" л | ДТ: " />
        <Run Text="{Binding AccountingCardProperties.RemaindMonthDieselValue, FallbackValue='—'}" />
        <Run Text=" л" />
                        </TextBlock>
                    </Grid>
                </Border>

                <DataGrid x:Name="dataGridByStateNumber"
          Grid.Row="1"
          ItemsSource="{Binding Records}"
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          IsReadOnly="True"
          HeadersVisibility="Column"
          GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="{StaticResource BorderColor}"
          VerticalGridLinesBrush="Transparent"
          RowHeight="40"
          Margin="16"
          ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
          BorderThickness="0"
          SnapsToDevicePixels="True"
          ScrollViewer.HorizontalScrollBarVisibility="Auto"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          ScrollViewer.CanContentScroll="True">


                    <DataGrid.Columns>
                        <!-- Число -->
                        <DataGridTextColumn Header="Число" Binding="{Binding DayNumber}" Width="Auto"
                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <!-- № путевого листа -->
                        <DataGridTextColumn Header="№ путевого листа" Binding="{Binding WaySheet}" Width="Auto"
                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <!-- Водитель №1 -->
                        <DataGridTextColumn Header="Водитель №1" Binding="{Binding FirstDriver}" Width="Auto"
                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <!-- Водитель №2 -->
                        <DataGridTextColumn Header="Водитель №2" Binding="{Binding SecondDriver}" Width="Auto"
                            ElementStyle="{StaticResource CellTextStyle}"/>

                        <!-- ГРУППА 1: ВЫДАНО -->
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="#F8FAFF">
                                            <TextBlock Text="Выдано" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryColor}" Padding="0,6"/>
                                        </Border>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="СУГ, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="Бензин, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0">
                                                <TextBlock Text="ДТ, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding GetGas, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding GetPetrol, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0">
                                            <TextBlock Text="{Binding GetDiesel, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ГРУППА 2: ПРОБЕГ, НОРМАТИВЫ -->
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="#F8FAFF">
                                            <TextBlock Text="Пробег, нормативы" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryColor}" Padding="0,6"/>
                                        </Border>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="Пробег, км" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="СУГ, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0">
                                                <TextBlock Text="Бензин, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding RemaindDayKilometrageValue, StringFormat={}{0:F0}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding GasConsumptionStandard, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0">
                                            <TextBlock Text="{Binding PetrolConsumptionStandard, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ГРУППА 3: РАСХОД -->
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="#F8FAFF">
                                            <TextBlock Text="Расход" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryColor}" Padding="0,6"/>
                                        </Border>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="СУГ, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="Бензин, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0">
                                                <TextBlock Text="ДТ, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding UsedGasValue, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding UsedPetrolValue, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0">
                                            <TextBlock Text="{Binding UsedDieselValue, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ГРУППА 4: ВСПОМОГАТЕЛЬНОЕ ОБОРУДОВАНИЕ -->
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="#F8FAFF">
                                            <TextBlock Text="Вспом. оборудование" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryColor}" Padding="0,6"/>
                                        </Border>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="Марка" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="СУГ, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="Бензин, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="3" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0">
                                                <TextBlock Text="ДТ, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding AdditionalToolBrand, FallbackValue='—'}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding AdditionalGasValue, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding AdditionalPetrolValue, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="3" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0">
                                            <TextBlock Text="{Binding AdditionalDieselValue, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- ГРУППА 5: ОСТАТОК НА КОНЕЦ ДНЯ -->
                        <DataGridTemplateColumn Width="Auto">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Background="#F8FAFF">
                                            <TextBlock Text="Остаток на конец дня" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource PrimaryColor}" Padding="0,6"/>
                                        </Border>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="Спидометр, км" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="СУГ, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                                <TextBlock Text="Бензин, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Column="3" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0">
                                                <TextBlock Text="ДТ, л" Style="{StaticResource GroupSubHeaderStyle}" TextAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding RemaindDayKilometrageValue, StringFormat={}{0:F0}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding RemaindDayGasValue, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="2" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="{Binding RemaindDayPetrolValue, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                        <Border Grid.Column="3" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,0">
                                            <TextBlock Text="{Binding RemaindDayDieselValue, StringFormat={}{0:F1}}" Style="{StaticResource CellTextStyle}" TextAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- === КНОПКИ === -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="0" x:Name="onMainWindow"
                    Content="ВЕРНУТЬСЯ НА ГЛАВНЫЙ ЭКРАН"
                    Style="{StaticResource ModernButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="onMainWindow_Click"/>

            <Button Grid.Row="0" Grid.Column="2" x:Name="btnAddData"
                    Content="Добавить запись"
                    Style="{StaticResource ModernButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="btnAddData_Click"/>
        </Grid>
    </Grid>
</Window>
