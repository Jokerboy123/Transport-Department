<Window x:Class="Transport_Department.MainWindow"
        x:Name="InitialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Transport_Department"
        mc:Ignorable="d"
        Title="Учет Tранспорта ГУП СК КРАЙТЕПЛОЭНЕРГО" 
        Height="450" 
        Width="599"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Палитра цветов -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#2C3E50"/>
        <SolidColorBrush x:Key="AccentColor" Color="#3498DB"/>
        <SolidColorBrush x:Key="AccentCloseColor" Color="#FFFF0000"/>

        <SolidColorBrush x:Key="TextColor" Color="#333333"/>
        <SolidColorBrush x:Key="HoverColor" Color="#2980B9"/>
        <SolidColorBrush x:Key="PressedColor" Color="#1C5980"/>

        <!-- Стиль для кнопок -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PressedColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModernButtonCloseStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentCloseColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
               
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Учет ГСМ ГУП СК «КРАЙТЕПЛОЭНЕРГО»"
               FontSize="20"
               FontWeight="Bold"
               Foreground="#2C3E50"
               TextAlignment="Center"
               Margin="0,0,0,25"/>
        <TextBlock Grid.Row="1" 
                   Text="Выберите район" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource TextColor}" 
                   Margin="0,0,0,20"
                   HorizontalAlignment="Center"/>

        <!-- Панель с кнопками -->
        <StackPanel Grid.Row="2" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Orientation="Vertical">

            <Button Content="Георгиевск" 
                    Click="GeoAccountPage_Click"
                    Name="GeoAccountPage"
                    Style="{StaticResource ModernButtonStyle}" 
                    Margin="0,0,0,15" />
            
            <Button Content="Георгиевский район" 
                    Click="GeoDistrictAccountPage_Click"
                    Name="GeoDistrictAccountPage"
                    Style="{StaticResource ModernButtonStyle}" 
                    Margin="0,0,0,15"/>

            <Button Content="Кировский район" 
                    Click="KirovskAccountPage_Click"
                    Name="KirovskAccountPage"
                    Style="{StaticResource ModernButtonStyle}"
                     Margin="0,0,0,15"/>
            
            <Button Content="Закрыть программу" 
                Click="CloseProgram_Click"
                x:Name="CloseProgram"
                Style="{StaticResource ModernButtonCloseStyle}"/>
        </StackPanel>
    </Grid>
</Window>
