<Window x:Class="TransportDepartment.MainWindow"
        x:Name="InitialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransportDepartment"
        mc:Ignorable="d"
        Height="500" 
        Width="599"
        Background="White"
        WindowStartupLocation="CenterScreen"
        Loaded="MainWindow_Loaded">

<Window.Resources>
    <!-- Палитра цветов -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#2C3E50"/>
    <SolidColorBrush x:Key="AccentColor" Color="#3498DB"/>
    <SolidColorBrush x:Key="CloseColor" Color="Red"/>       <!-- Красный для закрытия -->
        <SolidColorBrush x:Key="ParamsColor" Color="#48bf1d"/>      <!-- Зелёный для сохранения -->
          
        <SolidColorBrush x:Key="TextColor" Color="#333333"/>         <!-- Теперь этот ресурс существует -->
    <SolidColorBrush x:Key="HoverColor" Color="#2980B9"/>
        <SolidColorBrush x:Key="HoverCloseColor" Color="OrangeRed"/>
        <SolidColorBrush x:Key="HoverParamsColos" Color="#FF29A05B"/>

        <!-- Универсальный стиль для ВСЕХ кнопок -->
    <Style x:Key="ModernButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentColor}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <!-- Важно: Background берётся из TemplateBinding, а не жёстко задан -->
                    <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource HoverColor}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
        <Style x:Key="ModernButtonStyleRed" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CloseColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Важно: Background берётся из TemplateBinding, а не жёстко задан -->
                        <Border Background="{TemplateBinding Background}" 
                            CornerRadius="8" 
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverCloseColor}"/>
                </Trigger>
                
            </Style.Triggers>
        </Style>

        <Style x:Key="ModernButtonStyleGreen" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ParamsColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Важно: Background берётся из TemplateBinding, а не жёстко задан -->
                        <Border Background="{TemplateBinding Background}" 
                    CornerRadius="8" 
                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource HoverParamsColos}"/>
                </Trigger>
               
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Учет ГСМ ГУП СК «КРАЙТЕПЛОЭНЕРГО»"
               FontSize="20"
               FontWeight="Bold"
               Foreground="#2C3E50"
               TextAlignment="Center"
               Margin="0,0,0,25"/>
        <TextBlock Grid.Row="1" 
                   Text="Выберите район" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource TextColor}" 
                   Margin="0,0,0,25"
                   HorizontalAlignment="Center"/>

        <!-- Панель с кнопками -->
        <StackPanel Grid.Row="2" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Orientation="Vertical">

            <Button Content="Георгиевск" 
                    Click="GeoAccountPage_Click"
                    Name="GeoAccountPage"
                    Style="{StaticResource ModernButtonStyle}" 
                    Margin="0,0,0,15" />
            
            <Button Content="Георгиевский район" 
                    Click="GeoDistrictAccountPage_Click"
                    Name="GeoDistrictAccountPage"
                    Style="{StaticResource ModernButtonStyle}" 
                    Margin="0,0,0,15"/>

            <Button Content="Кировский район" 
                    Click="KirovskAccountPage_Click"
                    Name="KirovskAccountPage"
                    Style="{StaticResource ModernButtonStyle}"
                     Margin="0,0,0,15"/>

            <Button Content="Настройки программы"
                    Click="Parameters_Click"
                    Name="Parameters"
                    Style="{StaticResource ModernButtonStyleGreen}"
                     Margin="0,0,0,15"
                    />

            <Button Content="Закрыть программу" 
                Click="CloseProgram_Click"
                x:Name="CloseProgram"
                Style="{StaticResource ModernButtonStyleRed}"/>
        </StackPanel>
    </Grid>
</Window>
