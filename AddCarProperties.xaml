<Window x:Class="TransportDepartment.AddCarProperties"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransportDepartment"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        Title="Добавить данные"
        Height="580"
        Width="460"
        Background="#F5F7FA"
        Loaded="AddCarProperties_Loaded">

    <Grid Margin="32, 20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <Grid.Resources>
            <Color x:Key="AccentColor">#007ACC</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#005A9E"/>

            <Style TargetType="Label" x:Key="AddItem">
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
                <Setter Property="Margin" Value="0,0,16,0"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="#555555"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style  TargetType="TextBox" x:Key="ModernTextBoxStyle">
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Padding" Value="12,8"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="#E0E4E8"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TextBox}">
                            <Grid>
                                <Border x:Name="border" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                                    <ScrollViewer x:Name="PART_ContentHost" Margin="0" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>
                                </Border>

                                <!-- Слой подсказки (берёт текст из Tag) -->
                                <TextBlock x:Name="watermark"
                               Text="{TemplateBinding Tag}"
                               Foreground="#999999"
                               FontSize="14"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Margin="12,0,0,0"
                               IsHitTestVisible="False"
                               Visibility="Collapsed"/>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Показываем подсказку только если поле пустое И нет фокуса -->
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="Text" Value=""/>
                                        <Condition Property="IsFocused" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="watermark" Property="Visibility" Value="Visible"/>
                                </MultiTrigger>

                                <!-- Эффект при фокусе -->
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    <Setter TargetName="border" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#007ACC" Opacity="0.2"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsFocused" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#C0C6CC"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
   
            <!-- Заголовок (ОТДЕЛЬНО) -->
            <TextBlock Grid.Row="0" 
               Text="Добавление поездки" 
               HorizontalAlignment="Center" 
               FontSize="18" 
               FontWeight="Bold"
               Foreground="#333333"
               Margin="0, -10,0,15"/>

          
     

        <!-- Заголовок -->
     
        <!-- Число месяца -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox Grid.Column="1" Text="{Binding dayOfMonth, UpdateSourceTrigger=PropertyChanged}" 
                         Tag="Число месяца"
 Style="{StaticResource ModernTextBoxStyle}"/>
                <!-- Текст-подсказка. Он виден, только если поле пустое -->
            </Grid>
            <TextBox Grid.Column="4" x:Name="FourthDriverInput"
         Text="{Binding waySheet, UpdateSourceTrigger=PropertyChanged}"
         Style="{StaticResource ModernTextBoxStyle}"
         Tag="Номер путевого листа"
                              GotFocus="Placeholder_GotFocus" LostFocus="Placeholder_LostFocus" />
        </Grid>

        <!-- Номер путевого листа -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*"/>
                <ColumnDefinition Width="64*"/>
            </Grid.ColumnDefinitions>


        </Grid>

        <!-- Водитель 1 -->
        <Grid Grid.Row="3">
           
            <TextBox Grid.Column="1" x:Name="FirstDriverInput"
                     Tag="Водитель 1"
                     Text="{Binding FirstDriverFullName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"
                                          GotFocus="Placeholder_GotFocus" LostFocus="Placeholder_LostFocus"/>

        </Grid>

        <!-- Водитель 2 -->
        <Grid Grid.Row="5">
           
            <TextBox Grid.Column="1" x:Name="SecondDriverInput"
                     Tag="Водитель 2"
                                          GotFocus="Placeholder_GotFocus" LostFocus="Placeholder_LostFocus"

            Text ="{Binding SecondDriverFullName, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBoxStyle}"/>
        </Grid>

        <!-- Строка 6: три поля в ряд -->
        <!-- Строка 6: три поля в ряд -->
        
        <Grid Grid.Row="6" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>


            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Content="Выдано" Style="{StaticResource AddItem}" Margin="0, 0, 0, -10"/>

            <TextBox Grid.Row="2" Grid.Column="0" x:Name="GetGas" Tag="СУГ, л"
      Style="{StaticResource ModernTextBoxStyle}"/>
            <TextBox Grid.Row="2" Grid.Column="2" x:Name="GetPetrol" Tag="Бензин, л"
      Style="{StaticResource ModernTextBoxStyle}"/>
            <TextBox Grid.Row="2" Grid.Column="4" x:Name="GetDiesel" Tag="ДТ, л."
      Style="{StaticResource ModernTextBoxStyle}"/>
                  
        </Grid>
        <!-- Пустая строка для растягивания -->
        <Grid Grid.Row="8" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>


            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Content="Пробег, нормативы" Style="{StaticResource AddItem}" Margin="0, 0, 0, -10"/>

            <TextBox Grid.Row="2" Grid.Column="0" x:Name="Kilometrage" Tag="Пробег, км"
     Style="{StaticResource ModernTextBoxStyle}"/>
            <TextBox Grid.Row="2" Grid.Column="2" x:Name="Gas" Tag="СУГ, л"
     Style="{StaticResource ModernTextBoxStyle}"/>
            <TextBox Grid.Row="2" Grid.Column="4" x:Name="Petrol" Tag="Бензин, л"
     Style="{StaticResource ModernTextBoxStyle}"/>
        </Grid>
        
        <Grid Grid.Row="10" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>


            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="2" HorizontalAlignment="Center" Content="Расход" Style="{StaticResource AddItem}" Margin="0, 0, 0, -10"/>

            <TextBox Grid.Row="2" Grid.Column="0" x:Name="UsedGas" Tag="CУГ, л"
     Style="{StaticResource ModernTextBoxStyle}"/>
            <TextBox Grid.Row="2" Grid.Column="2" x:Name="UsedPetrol" Tag="Бензин, л"
     Style="{StaticResource ModernTextBoxStyle}"/>
            <TextBox Grid.Row="2" Grid.Column="4" x:Name="UsedDiesel" Tag="ДТ, л"
     Style="{StaticResource ModernTextBoxStyle}"/>
        </Grid>

        <Grid Grid.Row="12" Margin="0,0,0,8">
            <ComboBox Width="120"/>

        </Grid>
        <!-- Кнопка -->
        <Button Grid.Row="16" Content="Сохранить"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Padding="20,10" Margin="0,16,0,0" Tag="Пробег, км"
                FontSize="15" FontWeight="SemiBold"
                Background="{StaticResource AccentBrush}" Foreground="White"
                BorderThickness="0" Cursor="Hand" Click="Button_Click">
            <Button.Style>
                <Style TargetType="{x:Type Button}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Button}">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.95"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect ShadowDepth="2" BlurRadius="8" Color="Black" Opacity="0.15"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
