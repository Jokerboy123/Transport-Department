<Window x:Class="TransportDepartment.AddCarProperties"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить данные"
        Height="670" Width="460"
        Background="#F5F7FA"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Color x:Key="AccentColor">#007ACC</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#005A9E"/>

        <Color x:Key="ScrollTrackColor">#E0E4E8</Color>
        <Color x:Key="ScrollThumbColor">#007ACC</Color>
        <SolidColorBrush x:Key="ScrollTrackBrush" Color="{StaticResource ScrollTrackColor}"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}"/>

        <!-- Стиль для ScrollBar (не для ScrollViewer!) -->
        <Style x:Key="ModernScrollBar" TargetType="ScrollBar">
            <Setter Property="Background" Value="{StaticResource ScrollTrackBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Вертикальная полоса -->
                            <Border x:Name="Border"
                            Grid.Column="0"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Margin="2">
                                <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               Focusable="False">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{TemplateBinding Background}"
                                                   CornerRadius="4"
                                                   Opacity="0.9"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>

                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineDownCommand" Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineUpCommand" Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Border>

                            <!-- Горизонтальная полоса -->
                            <Border x:Name="HorizontalBorder"
                            Grid.Row="1"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Margin="2"
                            Visibility="Collapsed">
                                <Track Orientation="Horizontal"
                               x:Name="PART_HorizontalTrack"
                               Focusable="False">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="{TemplateBinding Background}"
                                                   CornerRadius="4"
                                                   Opacity="0.9"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>

                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineRightCommand" Opacity="0"/>
                                    </Track.IncreaseRepeatButton>
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineLeftCommand" Opacity="0"/>
                                    </Track.DecreaseRepeatButton>
                                </Track>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="Border" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="HorizontalBorder" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ScrollViewer без Style, но с нужными свойствами видимости скролла -->
    <ScrollViewer
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollBarVisibility="Auto"
        CanContentScroll="True">
        <Grid Margin="32, 20">
            <Grid.Resources>
                <Style TargetType="Label" x:Key="AddItem">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="HorizontalAlignment" Value="Left"/>
                    <Setter Property="Margin" Value="0,0,16,0"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                    <Setter Property="Foreground" Value="#555555"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>

                <Style x:Key="ModernTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Margin" Value="0,0,0,8"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TextBox">
                                <Border x:Name="border" Background="White" 
                                        BorderBrush="#E0E4E8" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <ScrollViewer x:Name="PART_ContentHost" Margin="8,5"/>
                                        <TextBlock x:Name="Watermark" Text="{TemplateBinding Tag}" 
                                                   Foreground="#999999" VerticalAlignment="Center" 
                                                   HorizontalAlignment="Left" Margin="12,0,0,0"
                                                   IsHitTestVisible="False" Visibility="Collapsed"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                                    </Trigger>
                                    <Trigger Property="IsFocused" Value="True">
                                        <Setter TargetName="Watermark" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Grid.Resources>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" Text="Добавление поездки" 
                       HorizontalAlignment="Center" FontSize="18" FontWeight="Bold"
                       Foreground="#333333" Margin="0,0,0,15"/>

            <!-- Число месяца + Путевой лист -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Text="{Binding DayNumber, UpdateSourceTrigger=PropertyChanged}"
                         Tag="Число месяца" Style="{StaticResource ModernTextBoxStyle}"/>
                <TextBox Grid.Column="2" Text="{Binding WaySheet, UpdateSourceTrigger=PropertyChanged}"
                         Tag="№ путевого листа" Style="{StaticResource ModernTextBoxStyle}"/>
            </Grid>

            <!-- Водитель 1 -->
            <TextBox Grid.Row="2" Text="{Binding FirstDriver, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Водитель 1" Style="{StaticResource ModernTextBoxStyle}"/>

            <!-- Водитель 2 -->
            <TextBox Grid.Row="3" Text="{Binding SecondDriver, UpdateSourceTrigger=PropertyChanged}"
                     Tag="Водитель 2" Style="{StaticResource ModernTextBoxStyle}"/>

            <!-- Выдано -->
            <Grid Grid.Row="4" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" HorizontalAlignment="Center" Content="Выдано" 
                       Style="{StaticResource AddItem}" Margin="0,0,0,-5"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding GetGas, UpdateSourceTrigger=PropertyChanged}"
                             Tag="СУГ, л" Style="{StaticResource ModernTextBoxStyle}"/>
                    <TextBox Grid.Column="2" Text="{Binding GetPetrol, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Бензин, л" Style="{StaticResource ModernTextBoxStyle}"/>
                    <TextBox Grid.Column="4" Text="{Binding GetDiesel, UpdateSourceTrigger=PropertyChanged}"
                             Tag="ДТ, л" Style="{StaticResource ModernTextBoxStyle}"/>
                </Grid>
            </Grid>

            <!-- Пробег, нормативы -->
            <!-- Пробег, нормативы -->
            <Grid Grid.Row="5" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" HorizontalAlignment="Center" Content="Пробег, нормативы" 
           Style="{StaticResource AddItem}" Margin="0,0,0,-5"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" 
                 Text="{Binding RemaindDayKilometrageValue, UpdateSourceTrigger=LostFocus, TargetNullValue=''}"
                 Tag="Пробег, км" Style="{StaticResource ModernTextBoxStyle}" Height="41" VerticalAlignment="Top" />
                    <!-- ИСПРАВЛЕНИЕ: OneWay, чтобы нельзя было менять норму из UI -->
                    <TextBox Grid.Column="2" 
                 Text="{Binding ExpectedGasValue, Mode=OneWay}"
                 Tag="Норма СУГ" Style="{StaticResource ModernTextBoxStyle}"
                 IsReadOnly="True"/>
                    <TextBox Grid.Column="4" 
                 Text="{Binding ExpectedPetrolValue, Mode=OneWay}"
                 Tag="Норма бензин" Style="{StaticResource ModernTextBoxStyle}"
                 IsReadOnly="True"/>
                </Grid>
            </Grid>

            <!-- Расход -->
            <Grid Grid.Row="6" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Label Grid.Row="0" HorizontalAlignment="Center" Content="Расход" 
                       Style="{StaticResource AddItem}" Margin="0,0,0,-5"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding UsedGasValue, UpdateSourceTrigger=PropertyChanged}"
                             Tag="СУГ, л" Style="{StaticResource ModernTextBoxStyle}"/>
                    <TextBox Grid.Column="2" Text="{Binding UsedPetrolValue, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Бензин, л" Style="{StaticResource ModernTextBoxStyle}"/>
                    <TextBox Grid.Column="4" Text="{Binding UsedDieselValue, UpdateSourceTrigger=PropertyChanged}"
                             Tag="ДТ, л" Style="{StaticResource ModernTextBoxStyle}"/>
                </Grid>
            </Grid>

            <!-- Дополнительное оборудование (Expander) -->
            <Expander Grid.Row="8" Header="Вспомогательное оборудование" Margin="0,0,0,8">
                <StackPanel>
                    <TextBox Text="{Binding AdditionalToolBrand, UpdateSourceTrigger=PropertyChanged}"
                             Tag="Наименование оборудования" Style="{StaticResource ModernTextBoxStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding AdditionalGasValue, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="СУГ, л" Style="{StaticResource ModernTextBoxStyle}"/>
                        <TextBox Grid.Column="2" Text="{Binding AdditionalPetrolValue, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Бензин, л" Style="{StaticResource ModernTextBoxStyle}"/>
                        <TextBox Grid.Column="4" Text="{Binding AdditionalDieselValue, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="ДТ, л" Style="{StaticResource ModernTextBoxStyle}"/>
                    </Grid>
                </StackPanel>
            </Expander>

            <!-- Кнопка Сохранить -->
            <Button Grid.Row="11" Content="Сохранить"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Padding="20,10" Margin="0,16,0,0"
                    FontSize="15" FontWeight="SemiBold"
                    Background="{StaticResource AccentBrush}" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="Button_Click">
                <Button.Style>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type Button}">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.95"/>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect ShadowDepth="2" BlurRadius="8" Color="Black" Opacity="0.15"/>
                                                </Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </ScrollViewer>
</Window>
