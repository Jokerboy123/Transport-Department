<Window x:Class="TransportDepartment.ParametersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TransportDepartment"
        mc:Ignorable="d"
        ResizeMode="NoResize"

        WindowState="Normal"
        
        WindowStartupLocation="CenterScreen"
        Title="ParametersWindow" Height="500" Width="600">
    <Window.Resources>
        <!-- Палитра цветов -->
        <SolidColorBrush x:Key="PrimaryColor" Color="#2C3E50"/>

        <!-- Цвета, точно соответствующие визуалу вашей кнопки -->
        <SolidColorBrush x:Key="ButtonBaseColor" Color="#3B8ED0"/>
        <SolidColorBrush x:Key="ButtonHoverColor" Color="#2E7ACF"/>
        <SolidColorBrush x:Key="ButtonPressedColor" Color="#256BB8"/>

        <!-- Стиль ModernButtonStyle, полностью инкапсулирующий логику кнопки -->
        <!-- Цвета: спокойные, не кричащие, но заметные -->
        <!-- Почти белый, но не стерильный -->
        <!-- Мягкий серый для рамки -->
        <!-- Деловой синий (не кислотный) -->

        <!-- Тёмно-графитовый, а не чёрный -->
        <Style x:Key="ModernButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBaseColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Border содержит скругление и тень -->
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Состояние: Наведение мыши -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonHoverColor}"/>
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" 
                                                          Opacity="0.4" 
                                                          BlurRadius="15" 
                                                          ShadowDepth="4"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Состояние: Нажатие -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{StaticResource ButtonPressedColor}"/>
                            </Trigger>

                            <!-- Состояние: По умолчанию (без наведения) -->
                            <Trigger Property="IsMouseOver" Value="False">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#000000" 
                                                          Opacity="0.2" 
                                                          BlurRadius="10" 
                                                          ShadowDepth="2"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FriendlyStrictButton" TargetType="Button">
            <Setter Property="Background" Value="#F5F6F7"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                    
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6" 
                            SnapsToDevicePixels="True">

                            <TextBlock x:Name="textBlock"
                               TextWrapping="Wrap"
                               TextAlignment="{TemplateBinding HorizontalContentAlignment}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               Foreground="{TemplateBinding Foreground}"
                               Padding="{TemplateBinding Padding}"
                               Text="{TemplateBinding Content}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Наведение: кнопка становится активной, но не «кричащей» -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="#2563EB"/>
                            </Trigger>

                            <!-- Нажатие: чёткое ощущение нажатия без «взрыва» цвета -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DBEAFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>

                            <!-- Фокус с клавиатуры: видно, что кнопка выбрана -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                            </Trigger>

                            <!-- Отключённое состояние: спокойно, без агрессии -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0"/>
                                <Setter TargetName="border" Property="TextElement.Foreground" Value="#94A3B8"/>
                                <Setter Property="Cursor" Value="No"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Border CornerRadius="50" >
            <GroupBox Header="Выбор месяца" 
                       HorizontalContentAlignment="Center"
         VerticalContentAlignment="Center"
          Padding="15" 
          Margin="20,20,349,345" 
          FontSize="14" 
          FontWeight="SemiBold" 
          Background="LightGray"
        BorderThickness="2"
          BorderBrush="Blue">
                <Border CornerRadius="60">
                    <ComboBox ItemsSource="{Binding Months}"
          SelectedItem="{Binding SelectedMonth, Mode=TwoWay}"
          FontSize="14"
                         x:Name="choseMonthValue" 
          
                    HorizontalContentAlignment="Stretch" 
          
          Background="White"
          BorderBrush="#CBD5E1"
          BorderThickness="1"
          Padding="-5,8" Margin="0,0,0,0" HorizontalAlignment="Right" Width="170">

                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Для выпадающего списка -->
                                <TextBlock Text="{Binding}" 
                       FontSize="14"
                       TextAlignment="Center" 
                       MinWidth="170"
                       Padding="0,5"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>


                        <!-- Стиль рамки при фокусе (опционально) -->
                        <ComboBox.Style>
                            <Style TargetType="ComboBox">
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="BorderBrush" Value="#2563EB"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Border>

            </GroupBox>
        </Border>
        <Border CornerRadius="50" >
            <GroupBox Header="Выбор года" 
          Padding="15" 
Margin="349,20,20,345"
                      FontSize="14" 
          FontWeight="SemiBold" 
          Background="LightGray"
        BorderThickness="2"
          BorderBrush="Blue">
                <TextBox Grid.Row="1"
                         x:Name="choseYearValue"
                         Height="60"
                         MaxHeight="60"
                         MinHeight="60"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         HorizontalContentAlignment="Center"
         VerticalContentAlignment="Center"
                  Text="{Binding SelectedYear, Mode=TwoWay}"
                  MaxLines="1"
                  FontSize="14"
                  Padding="12,6"
                  Background="White"
                  BorderBrush="#CBD5E1"
                         Width="180"
                         MaxWidth="180"
                         MinWidth="180"
                  BorderThickness="1" 
                         Margin="4,0,5,0" >

                    <!-- Стиль рамки при фокусе (опционально) -->
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="BorderBrush" Value="Blue"/>
                                    <Setter Property="BorderThickness" Value="2"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

            </GroupBox>
        </Border>
        <Button x:Name="onMainWindow"
            Content="ВЕРНУТЬСЯ НА ГЛАВНЫЙ ЭКРАН"
            Style="{StaticResource ModernButtonStyle}"
            HorizontalAlignment="Left" 
            VerticalAlignment="Bottom" 
            Margin="10,0,0,10" Click="onMainWindow_Click" />

    </Grid>
</Window>